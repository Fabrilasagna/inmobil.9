generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EstadoUnidad {
  prospecto
  calificada
  firmada
  en_alta
  publicada
  con_oferta
  reservada
  en_cierre
  cerrada
  retirada
}

enum TipoOperacion {
  venta
  alquiler
}

enum TipoAcceso {
  caja_codigo
  cerradura_inteligente
  ninguno
}

enum UrgenciaPropietario {
  baja
  media
  alta
}

enum NivelAcreditacion {
  no_acreditado
  nivel_1
  nivel_2
  suspendido
}

enum EstadoReservaVisita {
  solicitada
  confirmada
  acceso_emitido
  en_curso
  realizada
  cancelada
  no_asistio
  vencida
}

enum TipoEventoReserva {
  creacion
  notificacion_porteria
  confirmacion_porteria
  cancelacion
}

enum TipoEventoAcceso {
  codigo_validado
  apertura
  cierre
  denegado
  timeout
  apertura_caja
  entrada_camara
  salida_camara
}

enum ComparacionFotos {
  pendiente
  sin_diferencia
  marcada_revision
}

enum FeedbackInteres {
  si
  no
  tal_vez
}

enum MotivoFreno {
  precio
  tamano
  luz
  estado
  ubicacion
}

enum DerivacionVisita {
  negociador
  alternativas
  seguimiento_48h
  ninguna
}

enum EstadoOferta {
  enviada
  contraoferta
  aceptada
  rechazada
  caducada
  retirada
}

enum AutorMovimientoOferta {
  comprador
  propietario
  negociador
}

enum EstadoOperacionCierre {
  abierta
  documentacion
  pendiente_firma
  firmada
  caida
}

enum SeveridadIncidencia {
  baja
  media
  alta
  critica
}

enum EstadoIncidencia {
  abierta
  en_curso
  resuelta
  cerrada
}

enum CanalConversacion {
  whatsapp
  email
  telefono
  interno
}

enum EstadoConversacion {
  abierta
  archivada
}

enum DireccionMensaje {
  entrada
  salida
  interno
}

enum CanalContacto {
  whatsapp
  email
  telefono
}

model Edificio {
  id                      String   @id @default(cuid())
  nombre                  String
  direccion               String
  ciudad                  String
  codigoPostal            String?
  latitud                 Decimal? @db.Decimal(9, 6)
  longitud                Decimal? @db.Decimal(9, 6)
  administracionNombre    String?
  administracionContacto  String?
  porteriaContacto        String?
  porteriaCanal           String?
  protocoloAcceso         String?  @db.Text
  ventanaInicio           String   @default("08:00")
  ventanaFin              String   @default("21:00")
  duracionVisitaMinutos   Int      @default(45)
  intervaloMinimoMinutos  Int      @default(30)
  reglamento              String?  @db.Text
  acuerdoAdministracion   Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  unidades Unidad[]

  @@map("edificios")
}

model Unidad {
  id                   String              @id @default(cuid())
  referencia           String              @unique
  estado               EstadoUnidad        @default(prospecto)
  tipoOperacion        TipoOperacion       @default(venta)
  edificioId           String
  planta               String?
  puerta               String?
  tipologia            String?
  superficieM2         Decimal?            @db.Decimal(8, 2)
  habitaciones         Int?
  banos                Int?
  moneda               String              @default("USD")
  precioPedido         Decimal?            @db.Decimal(12, 2)
  precioPublicado      Decimal?            @db.Decimal(12, 2)
  precioMinimo         Decimal?            @db.Decimal(12, 2)
  urgencia             UrgenciaPropietario @default(media)
  formaPagoAceptada    String?
  descripcion          String?             @db.Text
  tipoAcceso           TipoAcceso          @default(ninguno)
  identificadorCaja    String?
  identificadorCamara  String?
  camaraConectada      Boolean             @default(false)
  urlRecorrido360      String?
  fotosLineaBase       Json?
  publicadaEn          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  edificio          Edificio             @relation(fields: [edificioId], references: [id], onDelete: Restrict)
  titulares         UnidadPropietario[]
  reservasVisita    ReservaVisita[]
  visitas           Visita[]
  ofertas           Oferta[]
  operacionesCierre OperacionCierre[]
  incidencias       Incidencia[]
  conversaciones    Conversacion[]
  eventosAcceso     EventoAcceso[]

  @@index([estado])
  @@index([tipoOperacion])
  @@index([edificioId])
  @@map("unidades")
}

model Propietario {
  id                     String        @id @default(cuid())
  nombre                 String
  apellidos              String
  email                  String        @unique
  telefono               String?
  documentoIdentidad     String?       @unique
  titularidadVerificada  Boolean       @default(false)
  acuerdoFirmadoEn       DateTime?
  canalContacto          CanalContacto @default(whatsapp)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  unidades       UnidadPropietario[]
  conversaciones Conversacion[]

  @@map("propietarios")
}

model UnidadPropietario {
  unidadId      String
  propietarioId String
  porcentaje    Decimal @default(100) @db.Decimal(5, 2)
  esContacto    Boolean @default(true)

  unidad      Unidad      @relation(fields: [unidadId], references: [id], onDelete: Cascade)
  propietario Propietario @relation(fields: [propietarioId], references: [id], onDelete: Restrict)

  @@id([unidadId, propietarioId])
  @@map("unidad_propietarios")
}

model Comprador {
  id                    String            @id @default(cuid())
  nombre                String
  apellidos             String
  email                 String            @unique
  telefono              String?
  identidadVerificada   Boolean           @default(false)
  nivelAcreditacion     NivelAcreditacion @default(no_acreditado)
  acreditadoEn          DateTime?
  esInversor            Boolean           @default(false)
  zonaBusqueda          String?
  metrosMin             Decimal?          @db.Decimal(8, 2)
  metrosMax             Decimal?          @db.Decimal(8, 2)
  presupuestoMin        Decimal?          @db.Decimal(12, 2)
  presupuestoMax        Decimal?          @db.Decimal(12, 2)
  monedaBusqueda        String            @default("USD")
  descartes             Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  reservasVisita    ReservaVisita[]
  visitas           Visita[]
  ofertas           Oferta[]
  operacionesCierre OperacionCierre[]
  conversaciones    Conversacion[]

  @@index([nivelAcreditacion])
  @@index([esInversor])
  @@map("compradores")
}

model ReservaVisita {
  id                   String              @id @default(cuid())
  unidadId             String
  compradorId          String
  estado               EstadoReservaVisita @default(solicitada)
  iniciaEn             DateTime
  terminaEn            DateTime
  codigoAcceso         String?
  codigoAccesoExpiraEn DateTime?
  porteriaNotificadaEn DateTime?
  porteriaConfirmadaEn DateTime?
  notas                String?             @db.Text
  canceladaEn          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  unidad        Unidad         @relation(fields: [unidadId], references: [id], onDelete: Restrict)
  comprador     Comprador      @relation(fields: [compradorId], references: [id], onDelete: Restrict)
  visita         Visita?
  eventosAcceso  EventoAcceso[]
  eventosReserva EventoReserva[]
  incidencias    Incidencia[]

  @@index([unidadId, iniciaEn])
  @@index([compradorId])
  @@index([estado])
  @@map("reservas_visita")
}

model EventoReserva {
  id              String            @id @default(cuid())
  reservaVisitaId String
  tipo            TipoEventoReserva
  ocurridoEn      DateTime          @default(now())
  payload         Json?

  reservaVisita ReservaVisita @relation(fields: [reservaVisitaId], references: [id], onDelete: Cascade)

  @@index([reservaVisitaId, ocurridoEn])
  @@map("eventos_reserva")
}

model EventoAcceso {
  id                 String           @id @default(cuid())
  reservaVisitaId    String?
  unidadId           String
  tipo               TipoEventoAcceso
  origen             String
  exitoso            Boolean          @default(true)
  personasDetectadas Int?
  ocurridoEn         DateTime         @default(now())
  metadata           Json?

  reservaVisita ReservaVisita? @relation(fields: [reservaVisitaId], references: [id], onDelete: SetNull)
  unidad        Unidad         @relation(fields: [unidadId], references: [id], onDelete: Restrict)

  @@index([reservaVisitaId, ocurridoEn])
  @@index([unidadId])
  @@map("eventos_acceso")
}

model Visita {
  id                String            @id @default(cuid())
  reservaVisitaId   String            @unique
  unidadId          String
  compradorId       String
  iniciadaEn        DateTime
  finalizadaEn      DateTime?
  fotosSalida       Json?
  comparacionFotos  ComparacionFotos  @default(pendiente)
  feedbackInteres   FeedbackInteres?
  motivoFreno       MotivoFreno?
  derivacion        DerivacionVisita  @default(ninguna)
  notasInternas     String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  reservaVisita ReservaVisita @relation(fields: [reservaVisitaId], references: [id], onDelete: Restrict)
  unidad        Unidad        @relation(fields: [unidadId], references: [id], onDelete: Restrict)
  comprador     Comprador     @relation(fields: [compradorId], references: [id], onDelete: Restrict)
  incidencias   Incidencia[]

  @@index([unidadId])
  @@index([compradorId])
  @@map("visitas")
}

model Oferta {
  id           String       @id @default(cuid())
  unidadId     String
  compradorId  String
  importe      Decimal      @db.Decimal(12, 2)
  moneda       String       @default("USD")
  estado       EstadoOferta @default(enviada)
  validezHasta DateTime?
  condiciones  String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  unidad      Unidad             @relation(fields: [unidadId], references: [id], onDelete: Restrict)
  comprador   Comprador          @relation(fields: [compradorId], references: [id], onDelete: Restrict)
  cierre      OperacionCierre?
  movimientos MovimientoOferta[]

  @@index([unidadId, estado])
  @@index([compradorId])
  @@map("ofertas")
}

model MovimientoOferta {
  id        String                 @id @default(cuid())
  ofertaId  String
  monto     Decimal                @db.Decimal(12, 2)
  moneda    String                 @default("USD")
  autor     AutorMovimientoOferta
  nota      String?                @db.Text
  createdAt DateTime               @default(now())

  oferta Oferta @relation(fields: [ofertaId], references: [id], onDelete: Cascade)

  @@index([ofertaId, createdAt])
  @@map("movimientos_oferta")
}

model OperacionCierre {
  id                 String                @id @default(cuid())
  unidadId           String
  ofertaId           String                @unique
  compradorId        String
  tipoOperacion      TipoOperacion         @default(venta)
  estado             EstadoOperacionCierre @default(abierta)
  precioAcordado     Decimal               @db.Decimal(12, 2)
  moneda             String                @default("USD")
  comision           Decimal?              @db.Decimal(12, 2)
  checklist          Json?
  fechaObjetivoFirma DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  unidad      Unidad      @relation(fields: [unidadId], references: [id], onDelete: Restrict)
  oferta      Oferta      @relation(fields: [ofertaId], references: [id], onDelete: Restrict)
  comprador   Comprador   @relation(fields: [compradorId], references: [id], onDelete: Restrict)
  incidencias Incidencia[]

  @@index([unidadId])
  @@index([estado])
  @@map("operaciones_cierre")
}

model Incidencia {
  id                String              @id @default(cuid())
  titulo            String
  descripcion       String              @db.Text
  tipo              String
  severidad         SeveridadIncidencia @default(media)
  estado            EstadoIncidencia    @default(abierta)
  evidencia         Json?
  resolucion        String?             @db.Text
  aplicacionGarantia Boolean            @default(false)
  unidadId          String?
  reservaVisitaId   String?
  visitaId          String?
  operacionCierreId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  unidad          Unidad?          @relation(fields: [unidadId], references: [id], onDelete: SetNull)
  reservaVisita   ReservaVisita?   @relation(fields: [reservaVisitaId], references: [id], onDelete: SetNull)
  visita          Visita?          @relation(fields: [visitaId], references: [id], onDelete: SetNull)
  operacionCierre OperacionCierre? @relation(fields: [operacionCierreId], references: [id], onDelete: SetNull)

  @@index([estado, severidad])
  @@index([unidadId])
  @@map("incidencias")
}

model Conversacion {
  id              String             @id @default(cuid())
  canal           CanalConversacion
  asunto          String
  estado          EstadoConversacion @default(abierta)
  ultimoMensaje   String?            @db.Text
  ultimoMensajeEn DateTime?
  derivadoAHumano Boolean            @default(false)
  unidadId        String?
  compradorId     String?
  propietarioId   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  unidad      Unidad?      @relation(fields: [unidadId], references: [id], onDelete: SetNull)
  comprador   Comprador?   @relation(fields: [compradorId], references: [id], onDelete: SetNull)
  propietario Propietario? @relation(fields: [propietarioId], references: [id], onDelete: SetNull)
  mensajes    Mensaje[]

  @@index([canal, estado])
  @@index([unidadId])
  @@map("conversaciones")
}

model Mensaje {
  id              String           @id @default(cuid())
  conversacionId  String
  cuerpo          String           @db.Text
  direccion       DireccionMensaje
  derivadoAHumano Boolean          @default(false)
  createdAt       DateTime         @default(now())

  conversacion Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@index([conversacionId, createdAt])
  @@map("mensajes")
}
