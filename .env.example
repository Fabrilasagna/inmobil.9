# PostgreSQL (Supabase o cualquier Postgres compatible)
# En Supabase: Project Settings → Database
# DATABASE_URL = pooled (puerto 6543) con ?pgbouncer=true
# DIRECT_URL   = sesión directa (puerto 5432) para migraciones Prisma
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Cliente JS de Supabase (opcional en esta fase; Prisma usa DATABASE_URL)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
